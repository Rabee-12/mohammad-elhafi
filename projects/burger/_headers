# Netlify caching — speeds up repeat visits / slow connections.
# Images rarely change → cache a week (served instantly on revisit).
/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
# Styles/scripts → cache a day; an update propagates within 24h.
/*.css
  Cache-Control: public, max-age=86400
/*.js
  Cache-Control: public, max-age=86400
